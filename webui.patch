+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Tracker Upload</title>
+<link rel="stylesheet" href="/static/style.css">
+</head>
+<body>
+<header>
+  <h1>Tracker Upload</h1>
+  <nav id="tabs">
+    <button data-tab="files" class="active">Files</button>
+    <button data-tab="jobs">Jobs <span id="jobs-badge" class="badge" hidden></span></button>
+    <button data-tab="library">Library</button>
+    <button data-tab="settings">Settings</button>
+  </nav>
+  <div id="tools" class="muted"></div>
+</header>
+<main>
+  <section id="tab-files"></section>
+  <section id="tab-jobs" hidden></section>
+  <section id="tab-library" hidden></section>
+  <section id="tab-settings" hidden></section>
+</main>
+<div id="lightbox" hidden></div>
+<div id="toast" hidden></div>
+<script src="/static/app.js"></script>
+</body>
+</html>
diff --git a/webui/static/style.css b/webui/static/style.css
new file mode 100644
