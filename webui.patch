+def _season(job: Job):
+    from .parsers import tv_numbers
+    return tv_numbers(job.sources)
+
+# ---- Torrent (the one generated locally) ---------------------------------
+variable("torrent_name", "Torrent", "Name inside the torrent", "The.Matrix.1999")(lambda job: getattr(_torrent(job), "name", ""))
+variable("torrent_size", "Torrent", "Total content size", "8.12 GiB")(lambda job: human_size(_torrent(job).size) if _torrent(job) else "")
+variable("torrent_size_bytes", "Torrent", "Total content size in bytes", "8719392768")(lambda job: getattr(_torrent(job), "size", ""))
+variable("torrent_infohash", "Torrent", "Info hash of the local torrent", "0123abcd...")(lambda job: getattr(_torrent(job), "infohash", ""))
+variable("torrent_files", "Torrent", "Number of files", "1")(lambda job: len(_torrent(job).files) if _torrent(job) else "")
+variable("torrent_piece_size", "Torrent", "Piece size", "16.00 MiB")(lambda job: human_size(_torrent(job).piece_size) if _torrent(job) else "")
