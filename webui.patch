+}
+@media (prefers-color-scheme: dark) {
+  :root { --bg: #14171c; --panel: #1c2027; --text: #e6e9ef; --muted: #8b94a5; --line: #2b313b;
+          --accent: #6b93ff; --accent-text: #0b1020; --ok: #4cc38a; --warn: #e0a43a; --bad: #ff7070; --sel: #232d45; }
+}
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.45 system-ui, sans-serif; }
+header { display: flex; align-items: center; gap: 24px; padding: 10px 20px; background: var(--panel); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; flex-wrap: wrap; }
+h1 { font-size: 16px; margin: 0; }
+h2 { font-size: 15px; margin: 0 0 10px; }
+nav { display: flex; gap: 4px; }
+nav button { background: none; border: 0; padding: 7px 12px; border-radius: 6px; color: var(--muted); cursor: pointer; font: inherit; }
+nav button.active { background: var(--sel); color: var(--accent); font-weight: 600; }
+main { padding: 16px 20px; max-width: 1400px; margin: 0 auto; }
+.muted { color: var(--muted); }
+.small { font-size: 12px; }
+.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px; }
+.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.grow { flex: 1; min-width: 0; }
+.spacer { height: 12px; }
+button.btn, a.btn { background: var(--panel); color: var(--text); border: 1px solid var(--line); border-radius: 6px; padding: 6px 12px; cursor: pointer; font: inherit; text-decoration: none; }
+button.btn:hover { border-color: var(--accent); }
+button.btn.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
+button.btn.danger { color: var(--bad); }
+button.btn.danger.fill { background: var(--bad); color: #fff; border-color: var(--bad); }
+button.btn:disabled { opacity: .45; cursor: not-allowed; }
+input[type=text], input[type=password], input[type=number] { background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 6px; padding: 6px 9px; font: inherit; }
+input[type=number] { width: 64px; }
+label.chk { display: inline-flex; gap: 6px; align-items: center; cursor: pointer; }
+.badge { background: var(--accent); color: var(--accent-text); border-radius: 9px; padding: 0 6px; font-size: 11px; }
+
+/* files */
+.files-layout { display: grid; grid-template-columns: 1fr 340px; gap: 14px; align-items: start; }
