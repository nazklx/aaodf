@@ -0,0 +1,159 @@
+"""Variables usable in description templates, e.g. "{tmdb_title} ({tmdb_year})\n\n{images}".
+
+To add a variable, write a function that takes the Job and returns a value, and
+register it with @variable. It then works in every tracker's description template and
+shows up (with its example) in the web UI's variable list. Nothing else to change.
+
+    @variable("video_bitrate", "File", "Overall bitrate", "12.4 Mb/s")
+    def _(job):
+        return ...
+
+Anything TMDB returned is also available without code as {tmdb.<field>},
+e.g. {tmdb.vote_average}, {tmdb.tagline}, {tmdb.original_title}.
+"""
+from __future__ import annotations
+import datetime
+import re
+from dataclasses import dataclass
+from typing import Callable
+
+from .core import human_size, video_duration
+from .models import Job
+
+@dataclass(frozen=True)
+class Variable:
+    name: str
+    group: str
+    description: str
+    example: str
+    func: Callable[[Job], object]
+
+REGISTRY: dict[str, Variable] = {}
+
+def variable(name: str, group: str, description: str, example: str = ""):
+    def register(func: Callable[[Job], object]) -> Callable[[Job], object]:
+        REGISTRY[name] = Variable(name, group, description, example, func)
+        return func
+    return register
+
+def _cached(job: Job, key: str, make: Callable[[], object]) -> object:
+    if key not in job.cache:
+        try:
+            job.cache[key] = make()
+        except Exception:  # a broken lookup must never break an upload
+            job.cache[key] = None
+    return job.cache[key]
+
+def _tags(job: Job) -> dict:
+    return job.tags or {}
+
+def _tmdb(job: Job, attr: str) -> object:
+    return getattr(job.info, attr, "") if job.info else ""
+
+def _tmdb_raw(job: Job, key: str) -> object:
+    value = (job.info.raw if job.info else {}).get(key, "")
+    if isinstance(value, list):
+        return ", ".join(str(v.get("name", v)) if isinstance(v, dict) else str(v) for v in value)
+    return "" if value is None else value
+
+def _torrent(job: Job):
+    def read():
+        from torf import Torrent
+        return Torrent.read(job.torrent_path)
+    return _cached(job, "torrent", read)
+
+def _hms(seconds: float | None) -> str:
+    if not seconds:
+        return ""
+    s = int(seconds)
+    return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}"
+
+# ---- TMDB ----------------------------------------------------------------
+variable("tmdb_id", "TMDB", "TMDB id", "603")(lambda job: _tmdb(job, "id") or "")
+variable("tmdb_title", "TMDB", "Title as TMDB has it", "The Matrix")(lambda job: _tmdb(job, "title"))
+variable("tmdb_year", "TMDB", "Release year", "1999")(lambda job: _tmdb(job, "year") or "")
+variable("tmdb_kind", "TMDB", "movie or tv", "movie")(lambda job: _tmdb(job, "kind"))
+variable("tmdb_label", "TMDB", "Title and year", "The Matrix (1999)")(lambda job: _tmdb(job, "label"))
+variable("overview", "TMDB", "TMDB plot summary", "A computer hacker learns...")(lambda job: job.overview or _tmdb(job, "overview"))
+variable("imdb_id", "TMDB", "IMDb id (digits)", "133093")(lambda job: _tmdb(job, "imdb_id") or "")
+variable("tvdb_id", "TMDB", "TVDB id (TV only)", "")(lambda job: _tmdb(job, "tvdb_id") or "")
+variable("tmdb_url", "TMDB", "Link to the TMDB page", "https://www.themoviedb.org/movie/603")(
+    lambda job: f"https://www.themoviedb.org/{job.info.kind}/{job.info.id}" if job.info else "")
+variable("imdb_url", "TMDB", "Link to the IMDb page", "https://www.imdb.com/title/tt0133093/")(
+    lambda job: f"https://www.imdb.com/title/tt{job.info.imdb_id:07d}/" if job.info and job.info.imdb_id else "")
+variable("tmdb_genres", "TMDB", "Genres", "Action, Science Fiction")(lambda job: _tmdb_raw(job, "genres"))
+variable("tmdb_rating", "TMDB", "Average vote (0-10)", "8.2")(lambda job: round(_tmdb_raw(job, "vote_average") or 0, 1) or "")
+variable("tmdb_tagline", "TMDB", "Tagline", "Welcome to the Real World.")(lambda job: _tmdb_raw(job, "tagline"))
+variable("tmdb_original_title", "TMDB", "Original title", "The Matrix")(
+    lambda job: _tmdb_raw(job, "original_title") or _tmdb_raw(job, "original_name"))
+variable("tmdb_release_date", "TMDB", "Release / first air date", "1999-03-31")(
+    lambda job: _tmdb_raw(job, "release_date") or _tmdb_raw(job, "first_air_date"))
+variable("tmdb_runtime", "TMDB", "Runtime in minutes (movies)", "136")(lambda job: _tmdb_raw(job, "runtime"))
+variable("tmdb_poster", "TMDB", "Poster image URL", "https://image.tmdb.org/t/p/w500/abc.jpg")(
+    lambda job: f"https://image.tmdb.org/t/p/w500{_tmdb_raw(job, 'poster_path')}" if _tmdb_raw(job, "poster_path") else "")
+
+# ---- Release / file ------------------------------------------------------
+variable("release", "File", "Release name (folder name, or file name without extension)", "The.Matrix.1999.1080p.BluRay.x264-GRP")(lambda job: job.release)
+variable("name", "File", "Name used for the output folder and torrent", "The.Matrix.1999.1080p.BluRay.x264-GRP")(lambda job: job.name)
+variable("file_name", "File", "First video file name", "The.Matrix.1999.1080p.BluRay.x264-GRP.mkv")(lambda job: job.first.name)
+variable("file_size", "File", "Size of the first video file", "8.12 GiB")(lambda job: human_size(job.first.stat().st_size))
+variable("file_size_bytes", "File", "Size of the first video file in bytes", "8719392768")(lambda job: job.first.stat().st_size)
+variable("file_count", "File", "Number of source videos (episodes)", "1")(lambda job: len(job.sources))
+variable("total_size", "File", "Combined size of all source videos", "8.12 GiB")(lambda job: human_size(sum(s.stat().st_size for s in job.sources)))
+variable("duration", "File", "Duration of the first video (h:mm:ss)", "2:16:09")(
+    lambda job: _hms(_cached(job, "duration", lambda: video_duration(job.first))))
+variable("mediainfo", "File", "Full mediainfo text", "General\nComplete name : ...")(lambda job: job.mediainfo)
+variable("resolution", "File", "Resolution tag", "1080p")(lambda job: _tags(job).get("resolution") or "")
+variable("source", "File", "Source tag", "BluRay")(lambda job: _tags(job).get("source") or "")
+variable("video_codec", "File", "Video codec", "x264")(lambda job: _tags(job).get("video") or "")
+variable("audio", "File", "Audio format", "DTS-HD MA 5.1")(lambda job: _tags(job).get("audio") or "")
+variable("hdr", "File", "HDR format", "HDR10")(lambda job: _tags(job).get("hdr") or "")
