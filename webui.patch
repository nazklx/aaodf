+variable("episode", "File", "Episode number (TV; empty for season packs)", "3")(lambda job: (_season(job) or ("", "", ""))[1] or "")
+variable("season_tag", "File", "Season/episode tag (TV)", "S01E03")(lambda job: (_season(job) or ("", "", ""))[2])
