+variable("date", "Upload", "Today (YYYY-MM-DD)", "2026-10-29")(lambda job: datetime.date.today().isoformat())
+
+_TOKEN = re.compile(r"\{([A-Za-z_][\w.]*)\}")
+
+def resolve(name: str, job: Job) -> str | None:
+    """Value for one variable, or None when the name is unknown (left untouched in the text)."""
+    if name.startswith("tmdb."):
+        value = _tmdb_raw(job, name[5:])
+    elif name in REGISTRY:
+        try:
+            value = REGISTRY[name].func(job)
+        except Exception:  # missing data (e.g. no TMDB match) renders as empty
+            value = ""
+    else:
+        return None
+    return "" if value is None else str(value)
+
+def render(template: str, job: Job) -> str:
+    def sub(m: re.Match) -> str:
+        value = resolve(m.group(1), job)
+        return m.group(0) if value is None else value
+    text = _TOKEN.sub(sub, template)
+    return re.sub(r"\n{3,}", "\n\n", text).strip()
+
+def describe_all() -> list[dict]:
+    return [{"name": v.name, "group": v.group, "description": v.description, "example": v.example} for v in REGISTRY.values()]
