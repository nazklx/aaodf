@@ -0,0 +1,224 @@
+"""Download clients (qBittorrent, Transmission, Deluge).
+
+After a successful upload the tracker returns a direct link to *its* .torrent file (not
+the one torf generated). We download that and hand the file to the client, pointing the
+client at the folder that already holds the content so it just verifies and seeds.
+
+To support another client, subclass Client and register it with @client_type.
+"""
+from __future__ import annotations
+import base64
+from pathlib import Path
+from urllib.parse import urlparse
+
+import requests
+
+from .config import CLIENT_DEFAULTS, ConfigError, Tracker, load_raw
+
+class ClientError(Exception):
+    pass
+
+CLIENT_TYPES: dict[str, type["Client"]] = {}
+
+def client_type(key: str, label: str):
+    def register(cls):
+        cls.key, cls.label = key, label
+        CLIENT_TYPES[key] = cls
+        return cls
+    return register
+
+class Client:
+    key = ""
+    label = ""
+    TIMEOUT = 30
+
+    def __init__(self, cfg: dict):
+        self.cfg = {**CLIENT_DEFAULTS, **cfg}
+        self.http = requests.Session()
+        self.base = self.cfg["url"].rstrip("/")
+
+    @property
+    def tags(self) -> list[str]:
+        return [t.strip() for t in str(self.cfg["tags"]).split(",") if t.strip()]
+
+    def save_path_for(self, content_parent: Path) -> str:
+        """Where the client should look for the data, translated for the client's filesystem."""
+        path = self.cfg["save_path"].strip() or str(content_parent)
+        local, remote = self.cfg["local_path"].strip(), self.cfg["remote_path"].strip()
+        if local and remote and path.startswith(local):
+            path = remote + path[len(local):]
+        return path
+
+    def add(self, data: bytes, filename: str, save_path: str) -> str:
+        raise NotImplementedError
+
+    def test(self) -> str:
+        raise NotImplementedError
+
+    def _post(self, url: str, **kw) -> requests.Response:
+        try:
+            return self.http.post(url, timeout=self.TIMEOUT, **kw)
+        except requests.RequestException as e:
+            raise ClientError(f"{self.label}: cannot reach {self.base} ({type(e).__name__})") from e
+
+@client_type("qbittorrent", "qBittorrent")
+class QBittorrent(Client):
+    def _login(self) -> None:
+        if not (self.cfg["username"] or self.cfg["password"]):
+            return  # auth bypass for localhost / whitelisted subnets
+        r = self._post(f"{self.base}/api/v2/auth/login", data={"username": self.cfg["username"], "password": self.cfg["password"]},
+                       headers={"Referer": self.base})
+        if r.text.strip() != "Ok.":
+            raise ClientError("qBittorrent: login failed (check username/password)")
+
+    def test(self) -> str:
+        self._login()
+        try:
+            r = self.http.get(f"{self.base}/api/v2/app/version", timeout=self.TIMEOUT, headers={"Referer": self.base})
+        except requests.RequestException as e:
+            raise ClientError(f"qBittorrent: cannot reach {self.base}") from e
+        if r.status_code != 200:
+            raise ClientError(f"qBittorrent: HTTP {r.status_code} (not logged in?)")
+        return f"qBittorrent {r.text.strip()}"
+
+    def add(self, data: bytes, filename: str, save_path: str) -> str:
+        self._login()
+        flag = lambda b: "true" if b else "false"  # noqa: E731
+        form = {"savepath": save_path, "autoTMM": "false", "paused": flag(self.cfg["paused"]),
+                "stopped": flag(self.cfg["paused"]),  # qBittorrent 5 renamed "paused" to "stopped"
+                "skip_checking": flag(self.cfg["skip_checking"])}
+        if self.cfg["category"]:
+            form["category"] = self.cfg["category"]
+        if self.tags:
+            form["tags"] = ",".join(self.tags)
+        r = self._post(f"{self.base}/api/v2/torrents/add", data=form, headers={"Referer": self.base},
+                       files={"torrents": (filename, data, "application/x-bittorrent")})
+        if r.status_code != 200 or r.text.strip() == "Fails.":
+            raise ClientError(f"qBittorrent rejected the torrent (HTTP {r.status_code}: {r.text.strip()[:100]})")
+        return f"added to qBittorrent (save path {save_path})"
+
+@client_type("transmission", "Transmission")
+class Transmission(Client):
+    def __init__(self, cfg: dict):
+        super().__init__(cfg)
+        self.rpc = self.base if self.base.endswith("/rpc") else self.base + "/transmission/rpc"
+        self.session_id = ""
+
+    def _call(self, method: str, arguments: dict) -> dict:
+        for _ in range(2):
+            headers = {"X-Transmission-Session-Id": self.session_id}
+            auth = (self.cfg["username"], self.cfg["password"]) if self.cfg["username"] else None
+            r = self._post(self.rpc, json={"method": method, "arguments": arguments}, headers=headers, auth=auth)
+            if r.status_code == 409:  # Transmission hands out a session id on the first request
+                self.session_id = r.headers.get("X-Transmission-Session-Id", "")
+                continue
+            if r.status_code == 401:
+                raise ClientError("Transmission: login failed (check username/password)")
+            if r.status_code != 200:
+                raise ClientError(f"Transmission: HTTP {r.status_code}")
+            body = r.json()
+            if body.get("result") != "success":
+                raise ClientError(f"Transmission: {body.get('result')}")
+            return body.get("arguments", {})
+        raise ClientError("Transmission: could not get a session id")
+
+    def test(self) -> str:
+        return f"Transmission {self._call('session-get', {}).get('version', '')}".strip()
+
+    def add(self, data: bytes, filename: str, save_path: str) -> str:
+        args = {"metainfo": base64.b64encode(data).decode(), "paused": bool(self.cfg["paused"]), "download-dir": save_path}
+        labels = ([self.cfg["category"]] if self.cfg["category"] else []) + self.tags
+        if labels:
+            args["labels"] = labels
+        res = self._call("torrent-add", args)
+        if "torrent-duplicate" in res:
+            return "already in Transmission"
+        return f"added to Transmission (save path {save_path})"
+
+@client_type("deluge", "Deluge (Web UI)")
+class Deluge(Client):
+    def __init__(self, cfg: dict):
+        super().__init__(cfg)
+        self.endpoint = self.base if self.base.endswith("/json") else self.base + "/json"
+        self._id = 0
+
+    def _call(self, method: str, params: list):
+        self._id += 1
+        r = self._post(self.endpoint, json={"method": method, "params": params, "id": self._id})
+        if r.status_code != 200:
+            raise ClientError(f"Deluge: HTTP {r.status_code}")
+        body = r.json()
+        if body.get("error"):
+            raise ClientError(f"Deluge: {body['error'].get('message', body['error'])}")
+        return body.get("result")
+
+    def _login(self) -> None:
+        if not self._call("auth.login", [self.cfg["password"]]):
+            raise ClientError("Deluge: login failed (check the Web UI password)")
+        if not self._call("web.connected", []):
+            hosts = self._call("web.get_hosts", [])
+            if not hosts:
+                raise ClientError("Deluge: Web UI is not connected to a daemon")
+            self._call("web.connect", [hosts[0][0]])
+
+    def test(self) -> str:
+        self._login()
+        return f"Deluge {self._call('daemon.get_version', [])}"
+
+    def add(self, data: bytes, filename: str, save_path: str) -> str:
+        self._login()
+        opts = {"download_location": save_path, "add_paused": bool(self.cfg["paused"])}
+        tid = self._call("core.add_torrent_file", [filename, base64.b64encode(data).decode(), opts])
+        if not tid:
+            return "already in Deluge"
+        if self.cfg["category"]:  # needs the Label plugin; ignore failures
+            try:
+                self._call("label.set_torrent", [tid, self.cfg["category"]])
+            except ClientError:
+                pass
+        return f"added to Deluge (save path {save_path})"
+
+def make_client(name: str, cfg: dict | None = None) -> Client:
+    cfg = cfg or load_raw()
+    if name not in cfg["download_clients"]:
+        raise ClientError(f'Download client "{name}" is not configured')
+    entry = cfg["download_clients"][name]
+    if entry["type"] not in CLIENT_TYPES:
+        raise ClientError(f'Unknown client type "{entry["type"]}"')
+    return CLIENT_TYPES[entry["type"]](entry)
+
+def fetch_tracker_torrent(tracker: Tracker, url: str) -> bytes:
+    """Download the tracker's own .torrent. The API token is only sent to the tracker's host."""
+    headers = {}
+    if urlparse(url).netloc == urlparse(tracker.upload_endpoint).netloc:
+        headers["Authorization"] = f"Bearer {tracker.api_token.strip()}"
+    try:
+        r = requests.get(url, headers=headers, timeout=60)
+    except requests.RequestException as e:
+        raise ClientError(f"could not download the tracker's .torrent ({type(e).__name__})") from e
+    if r.status_code != 200:
+        raise ClientError(f"tracker .torrent download failed (HTTP {r.status_code})")
+    if not r.content.startswith(b"d"):  # bencoded dictionary
+        raise ClientError("the tracker link did not return a .torrent file")
+    return r.content
+
+def resolve_client_name(tracker: Tracker, override: str | None) -> str | None:
+    """override: None = tracker default, "none" = no client, anything else = that client."""
+    if override == "none":
+        return None
+    return (override or tracker.download_client or "").strip() or None
+
+def add_release_to_client(client_name: str, tracker: Tracker, torrent_url: str, target: Path,
+                          torrent_name: str, copy_to: Path | None = None) -> str:
+    """Download the tracker's .torrent and add it to the client. Returns a status message."""
+    try:
+        client = make_client(client_name)
+    except ConfigError as e:
+        raise ClientError(str(e)) from e
+    data = fetch_tracker_torrent(tracker, torrent_url)
+    if copy_to:
+        try:
+            copy_to.write_bytes(data)
+        except OSError:
+            pass
+    return client.add(data, f"{torrent_name}.torrent", client.save_path_for(target.parent))
